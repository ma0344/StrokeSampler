{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build DotLab",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/DotLab/DotLab.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "build DotTester",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/DotTester/DotTester.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "build SkiaTester",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/SkiaTester/SkiaTester.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "build StrokeSampler (UWP x64)",
      "type": "shell",
      "command": "$msbuild = & 'C:\\Program Files (x86)\\Microsoft Visual Studio\\Installer\\vswhere.exe' -latest -products * -requires Microsoft.Component.MSBuild -find 'MSBuild\\**\\Bin\\MSBuild.exe' | Select-Object -First 1; if (-not $msbuild) { throw 'MSBuild.exe が見つかりません。'; }; & $msbuild '${workspaceFolder}\\StrokeSampler.csproj' /t:Build /p:Configuration=Debug /p:Platform=x64 /property:GenerateFullPaths=true '/consoleloggerparameters:NoSummary;ForceNoAlign'",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "build InkDrawGen (UWP x64)",
      "type": "shell",
      "command": "$msbuild = & 'C:\\Program Files (x86)\\Microsoft Visual Studio\\Installer\\vswhere.exe' -latest -products * -requires Microsoft.Component.MSBuild -find 'MSBuild\\**\\Bin\\MSBuild.exe' | Select-Object -First 1; if (-not $msbuild) { throw 'MSBuild.exe が見つかりません。'; }; & $msbuild '${workspaceFolder}\\InkDrawGen\\InkDrawGen.csproj' /t:Build /p:Configuration=Debug /p:Platform=x64 /property:GenerateFullPaths=true '/consoleloggerparameters:NoSummary;ForceNoAlign'",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "build All Desktop Projects",
      "dependsOrder": "sequence",
      "dependsOn": ["build DotLab", "build DotTester", "build SkiaTester"],
      "problemMatcher": []
    },
    {
      "label": "build All Projects",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build All Desktop Projects",
        "build StrokeSampler (UWP x64)",
        "build InkDrawGen (UWP x64)"
      ],
      "problemMatcher": []
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/DotLab/DotLab.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/DotLab/DotLab.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/DotLab/DotLab.csproj"
      ],
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
