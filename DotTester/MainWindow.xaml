<Window x:Class="DotTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        mc:Ignorable="d"
        Title="DotTester"
        Height="1900"
        Width="1800"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,12">
                <TextBlock Text="Expected PNG:"
                           VerticalAlignment="Center" />
                <TextBox x:Name="ExpectedPathTextBox"
                         Width="520"
                         Margin="8,0,8,0" />
                <Button x:Name="BrowseExpectedButton"
                        Content="Browse..."
                        Width="90"
                        Click="BrowseExpectedButton_Click" />

                <TextBlock Text="S(px):"
                           VerticalAlignment="Center"
                           Margin="16,0,6,0" />
                <ui:NumberBox x:Name="DiameterNumberBox"
                              Width="150"
                              Minimum="1"
                              Maximum="2000"
                              Value="200"
                              SpinButtonPlacementMode="Inline" />

                <TextBlock Text="Scale:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="RenderScaleNumberBox"
                              Width="110"
                              Minimum="1"
                              Maximum="64"
                              Value="10"
                              SpinButtonPlacementMode="Inline" />

                <TextBlock Text="P:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="PressureNumberBox"
                              Width="120"
                              Minimum="0.00001"
                              Maximum="1"
                              Value="1"
                              SmallChange="0.0001"
                              LargeChange="0.01"
                              SpinButtonPlacementMode="Inline" />

                <Button x:Name="RenderButton"
                        Content="Render (N=1)"
                        Width="120"
                        Margin="16,0,0,0"
                        Click="RenderButton_Click" />
                <Button x:Name="SaveRenderedPngButton"
                        Content="Save Rendered PNG..."
                        Width="170"
                        Margin="8,0,0,0"
                        Click="SaveRenderedPngButton_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBlock Text="Tile PNG:"
                           VerticalAlignment="Center"
                           Margin="0,0,43,0" />
                <TextBox x:Name="PaperNoisePathTextBox"
                         Width="520"
                         Margin="0,0,8,0" />
                <Button x:Name="BrowsePaperNoiseButton"
                        Content="Browse..."
                        Width="90"
                        Click="BrowsePaperNoiseButton_Click" />
                <CheckBox x:Name="UsePaperNoiseCheckBox"
                          Content="PaperNoise"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0" />
                <CheckBox x:Name="AutoCanvasSizeCheckBox"
                          Content="Auto canvas (S*Scale + Pad)"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="20,0,6,0" />
                <TextBlock Text="Pad(px):"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="CanvasPadNumberBox"
                              Width="110"
                              Minimum="0"
                              Maximum="4096"
                              Value="0"
                              SpinButtonPlacementMode="Inline" />
                <TextBlock Text="EdgePad(px):"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="RadiusPadNumberBox"
                              Width="110"
                              Minimum="0"
                              Maximum="2"
                              Value="0"
                              SmallChange="0.1"
                              LargeChange="0.5"
                              SpinButtonPlacementMode="Inline" />
                <TextBlock Text="Canvas(px):"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="CanvasSizeNumberBox"
                              Width="150"
                              Minimum="1"
                              Maximum="20000"
                              Value="2020"
                              SpinButtonPlacementMode="Inline" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,6,0,16">
                <TextBlock Text="Falloff CSV:      "
                           VerticalAlignment="Center" />
                <TextBox x:Name="FalloffCsvPathTextBox"
                         Width="520"
                         Margin="8,0,8,0" />
                <Button x:Name="BrowseFalloffCsvButton"
                        Content="Browse..."
                        Width="90"
                        Click="BrowseFalloffCsvButton_Click" />
                <CheckBox x:Name="AlphaViewCheckBox"
                          Content="Alpha view"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0" />
                <CheckBox x:Name="NearestPreviewCheckBox"
                          Content="Nearest"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0" />
                <CheckBox x:Name="AutoPaperNoiseScaleCheckBox"
                          Content="Auto noiseScale (=Scale/TileScale)"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0" />
                <TextBlock Text="TileScale:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="PaperNoiseTileScaleNumberBox"
                              Width="110"
                              Minimum="1"
                              Maximum="64"
                              Value="10"
                              SpinButtonPlacementMode="Inline" />
                <TextBlock Text="noiseScale:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="PaperNoiseScaleNumberBox"
                              Width="150"
                              Minimum="0.0001"
                              Maximum="64"
                              Value="1"
                              SmallChange="0.1"
                              LargeChange="1"
                              SpinButtonPlacementMode="Inline" />

                <TextBlock Text="OffsetX:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="PaperNoiseOffsetXNumberBox"
                              Width="110"
                              Minimum="-4096"
                              Maximum="4096"
                              Value="0"
                              SmallChange="1"
                              LargeChange="16"
                              SpinButtonPlacementMode="Inline" />

                <TextBlock Text="OffsetY:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="PaperNoiseOffsetYNumberBox"
                              Width="110"
                              Minimum="-4096"
                              Maximum="4096"
                              Value="0"
                              SmallChange="1"
                              LargeChange="16"
                              SpinButtonPlacementMode="Inline" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,16">
                <TextBlock Text="k mode:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ComboBox x:Name="PaperNoiseKModeComboBox"
                          Width="200"
                          SelectedIndex="1">
                    <ComboBoxItem Content="C: Direct (k=n01)"
                                  Tag="Direct01" />
                    <ComboBoxItem Content="A: Ratio (k=n01/mean)"
                                  Tag="RatioToMean" />
                    <ComboBoxItem Content="B: Blend to 1"
                                  Tag="BlendToMean1" />
                    <ComboBoxItem Content="U: ZNorm (k=1+(s*g)*z)"
                                  Tag="ZNormalized" />
                </ComboBox>

                <TextBlock Text="Sampling:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ComboBox x:Name="PaperNoiseSamplingComboBox"
                          Width="140"
                          SelectedIndex="1">
                    <ComboBoxItem Content="Nearest"
                                  Tag="Nearest" />
                    <ComboBoxItem Content="Bilinear"
                                  Tag="Bilinear" />
                    <ComboBoxItem Content="Bicubic"
                                  Tag="Bicubic" />
                </ComboBox>

                <TextBlock Text="Apply:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ComboBox x:Name="PaperNoiseApplyModeComboBox"
                          Width="140"
                          SelectedIndex="1">
                    <ComboBoxItem Content="Multiply"
                                  Tag="Multiply" />
                    <ComboBoxItem Content="Add"
                                  Tag="Add" />
                </ComboBox>

                <TextBlock Text="Model:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ComboBox x:Name="OutAlphaModelComboBox"
                          Width="170"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Multiply (k)"
                                  Tag="MultiplyK" />
                    <ComboBoxItem Content="Wall-through"
                                  Tag="WallThrough" />
                </ComboBox>

            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,16">
                <TextBlock Text="Strength:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="PaperNoiseStrengthNumberBox"
                              Width="120"
                              Minimum="0"
                              Maximum="2"
                              Value="0.28"
                              SmallChange="0.01"
                              LargeChange="0.05"
                              SpinButtonPlacementMode="Inline" />
                <TextBlock Text="Gain:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="PaperNoiseGainNumberBox"
                              Width="120"
                              Minimum="0"
                              Maximum="50"
                              Value="1"
                              SmallChange="0.1"
                              LargeChange="1"
                              SpinButtonPlacementMode="Inline" />

                <Separator Height="20" />

                <TextBlock Text="WallK:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="WallKNumberBox"
                              Width="120"
                              Minimum="0.001"
                              Maximum="2"
                              Value="0.26"
                              SmallChange="0.01"
                              LargeChange="0.05"
                              SpinButtonPlacementMode="Inline" />

                <TextBlock Text="base×"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="WallBaseScaleNumberBox"
                              Width="120"
                              Minimum="0.1"
                              Maximum="10"
                              Value="0.3"
                              SmallChange="0.01"
                              LargeChange="0.25"
                              SpinButtonPlacementMode="Inline" />

                <TextBlock Text="bias"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="WallThresholdBiasNumberBox"
                              Width="140"
                              Minimum="-1"
                              Maximum="1"
                              Value="-0.41"
                              SmallChange="0.002"
                              LargeChange="0.05"
                              SpinButtonPlacementMode="Inline" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,16">

                <TextBlock Text="FalloffScale:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="FalloffScaleNumberBox"
                              Width="120"
                              Minimum="0"
                              Maximum="10"
                              Value="1"
                              SmallChange="0.05"
                              LargeChange="0.25"
                              SpinButtonPlacementMode="Inline" />

                <TextBlock Text="RNormScale:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="FalloffRNormScaleNumberBox"
                              Width="120"
                              Minimum="0.1"
                              Maximum="5"
                              Value="1"
                              SmallChange="0.02"
                              LargeChange="0.1"
                              SpinButtonPlacementMode="Inline" />

                <TextBlock Text="Gamma:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="FalloffGammaNumberBox"
                              Width="120"
                              Minimum="0.1"
                              Maximum="5"
                              Value="1"
                              SmallChange="0.05"
                              LargeChange="0.25"
                              SpinButtonPlacementMode="Inline" />
            </StackPanel>
            <Separator Height="10"
                       Margin="0,0,0,8" />


            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">

                <TextBlock Text="zClamp:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <CheckBox x:Name="EnablePaperNoiseZClampCheckBox"
                          Content="ON"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="0,0,-60,0"
                          Checked="PaperNoiseZClampUiChanged"
                          Unchecked="PaperNoiseZClampUiChanged" />
                <TextBlock Text="-"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ui:NumberBox x:Name="PaperNoiseZClampNegAbsNumberBox"
                              Width="95"
                              Minimum="0.1"
                              Maximum="50"
                              Value="7"
                              SmallChange="0.5"
                              LargeChange="1"
                              SpinButtonPlacementMode="Inline" />
                <TextBlock Text="+"
                           VerticalAlignment="Center"
                           Margin="8,0,6,0" />
                <ui:NumberBox x:Name="PaperNoiseZClampPosAbsNumberBox"
                              Width="95"
                              Minimum="0.1"
                              Maximum="50"
                              Value="7"
                              SmallChange="0.5"
                              LargeChange="1"
                              SpinButtonPlacementMode="Inline" />

                <TextBlock Text="kClamp:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="PaperNoiseKClampMinNumberBox"
                              Width="120"
                              Minimum="0.0001"
                              Maximum="10"
                              Value="0.0001"
                              SmallChange="0.1"
                              LargeChange="0.5"
                              SpinButtonPlacementMode="Inline" />
                <TextBlock Text=".."
                           VerticalAlignment="Center"
                           Margin="6,0,6,0" />
                <ui:NumberBox x:Name="PaperNoiseKClampMaxNumberBox"
                              Width="120"
                              Minimum="0.0001"
                              Maximum="10"
                              Value="1.5"
                              SmallChange="0.1"
                              LargeChange="0.5"
                              SpinButtonPlacementMode="Inline" />
                <CheckBox x:Name="DisableKMeanNormalizationCheckBox"
                          Content="Disable kMean norm"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0" />

                <Separator />

                <TextBlock Text="EdgeBoost:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <CheckBox x:Name="EnablePaperNoiseEdgeBoostCheckBox"
                          Content="ON"
                          IsChecked="False"
                          VerticalAlignment="Center"
                          Margin="0,0,-60,0"
                          Checked="PaperNoiseEdgeBoostUiChanged"
                          Unchecked="PaperNoiseEdgeBoostUiChanged" />
                <TextBlock Text="boost:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ui:NumberBox x:Name="PaperNoiseEdgeBoostNumberBox"
                              Width="95"
                              Minimum="0"
                              Maximum="10"
                              Value="0"
                              SmallChange="0.05"
                              LargeChange="0.25"
                              SpinButtonPlacementMode="Inline" />
                <TextBlock Text="gamma:"
                           VerticalAlignment="Center"
                           Margin="8,0,6,0" />
                <ui:NumberBox x:Name="PaperNoiseEdgeBoostGammaNumberBox"
                              Width="95"
                              Minimum="0.1"
                              Maximum="10"
                              Value="1"
                              SmallChange="0.1"
                              LargeChange="0.5"
                              SpinButtonPlacementMode="Inline" />
            </StackPanel>


            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBlock Text="Cutoff:"
                           VerticalAlignment="Center" />
                <TextBlock Text="alpha(byte):"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="AlphaCutoffByteNumberBox"
                              Width="110"
                              Minimum="0"
                              Maximum="255"
                              Value="0"
                              SmallChange="1"
                              LargeChange="10"
                              SpinButtonPlacementMode="Inline" />
                <CheckBox x:Name="NoiseDependentCutoffCheckBox"
                          Content="noise-dependent cutoff (×k)"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0" />
                <TextBlock Text="PaperMask:"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="PaperMaskModeComboBox"
                          Width="210"
                          Margin="12,0,0,0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="None"
                                  Tag="None" />
                    <ComboBoxItem Content="Multiply outA"
                                  Tag="MultiplyOutAlpha" />
                    <ComboBoxItem Content="Soft outA"
                                  Tag="SoftOutAlpha" />
                    <ComboBoxItem Content="Threshold outA"
                                  Tag="ThresholdOutAlpha" />
                </ComboBox>

                <TextBlock Text="th:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="PaperMaskThresholdNumberBox"
                              Width="110"
                              Minimum="0"
                              Maximum="1"
                              Value="0.5"
                              SmallChange="0.01"
                              LargeChange="0.05"
                              SpinButtonPlacementMode="Inline" />

                <TextBlock Text="gain:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="PaperMaskGainNumberBox"
                              Width="110"
                              Minimum="0"
                              Maximum="50"
                              Value="1"
                              SmallChange="0.1"
                              LargeChange="1"
                              SpinButtonPlacementMode="Inline" />

                <TextBlock Text="edge:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ComboBox x:Name="PaperMaskFalloffModeComboBox"
                          Width="210"
                          SelectedIndex="0">
                    <ComboBoxItem Content="None"
                                  Tag="None" />
                    <ComboBoxItem Content="Stronger at edge"
                                  Tag="StrongerAtEdge" />
                    <ComboBoxItem Content="Threshold at edge"
                                  Tag="ThresholdAtEdge" />
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBlock Text="Tile extrema:"
                           VerticalAlignment="Center" />

                <TextBlock Text="Bright(x,y):"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="TileBrightXNumberBox"
                              Width="120"
                              Minimum="0"
                              Maximum="4096"
                              Value="404"
                              SpinButtonPlacementMode="Inline" />
                <ui:NumberBox x:Name="TileBrightYNumberBox"
                              Width="120"
                              Minimum="0"
                              Maximum="4096"
                              Value="131"
                              Margin="6,0,0,0"
                              SpinButtonPlacementMode="Inline" />

                <TextBlock Text="Dark(x,y):"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="TileDarkXNumberBox"
                              Width="120"
                              Minimum="0"
                              Maximum="4096"
                              Value="25"
                              SpinButtonPlacementMode="Inline" />
                <ui:NumberBox x:Name="TileDarkYNumberBox"
                              Width="120"
                              Minimum="0"
                              Maximum="4096"
                              Value="199"
                              Margin="6,0,0,0"
                              SpinButtonPlacementMode="Inline" />

                <TextBlock Text="Expected:"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ComboBox x:Name="ExpectedAlphaModeComboBox"
                          Width="210"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Auto"
                                  Tag="Auto" />
                    <ComboBoxItem Content="Use alpha"
                                  Tag="Alpha" />
                    <ComboBoxItem Content="White bg (255-luma)"
                                  Tag="White" />
                </ComboBox>

                <Button x:Name="EvaluateTileExtremaButton"
                        Content="Evaluate"
                        Width="110"
                        Margin="12,0,0,0"
                        Click="EvaluateTileExtremaButton_Click" />

                <TextBlock Text="Edge scatter:"
                           VerticalAlignment="Center"
                           Margin="16,0,6,0" />
                <TextBlock Text="a8"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ui:NumberBox x:Name="EdgeScatterAlphaMinByteNumberBox"
                              Width="90"
                              Minimum="0"
                              Maximum="255"
                              Value="1"
                              SmallChange="1"
                              LargeChange="10"
                              SpinButtonPlacementMode="Inline" />
                <TextBlock Text=".."
                           VerticalAlignment="Center"
                           Margin="6,0,6,0" />
                <ui:NumberBox x:Name="EdgeScatterAlphaMaxByteNumberBox"
                              Width="90"
                              Minimum="0"
                              Maximum="255"
                              Value="64"
                              SmallChange="1"
                              LargeChange="10"
                              SpinButtonPlacementMode="Inline" />
                <TextBlock Text="stride"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ui:NumberBox x:Name="EdgeScatterStrideNumberBox"
                              Width="90"
                              Minimum="1"
                              Maximum="32"
                              Value="4"
                              SmallChange="1"
                              LargeChange="2"
                              SpinButtonPlacementMode="Inline" />
                <Button x:Name="ExportEdgeScatterCsvButton"
                        Content="Export CSV"
                        Width="110"
                        Margin="12,0,0,0"
                        Click="ExportEdgeScatterCsvButton_Click" />
            </StackPanel>
            <Expander Header="Sweep">

                <StackPanel Orientation="Vertical"
                            Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,0">

                        <TextBlock Text="kMean stride(px):"
                                   VerticalAlignment="Center"
                                   Margin="16,0,6,0" />
                        <ui:NumberBox x:Name="SweepKMeanStrideNumberBox"
                                      Width="120"
                                      Minimum="1"
                                      Maximum="64"
                                      Value="8"
                                      SpinButtonPlacementMode="Inline" />

                        <TextBlock Text="Parallel:"
                                   VerticalAlignment="Center"
                                   Margin="16,0,6,0" />
                        <ui:NumberBox x:Name="SweepParallelDegreeNumberBox"
                                      Width="120"
                                      Minimum="1"
                                      Maximum="32"
                                      Value="4"
                                      SpinButtonPlacementMode="Inline" />

                        <TextBlock Text="Max iters:"
                                   VerticalAlignment="Center"
                                   Margin="16,0,6,0" />
                        <ui:NumberBox x:Name="SweepMaxItersNumberBox"
                                      Width="160"
                                      Minimum="1000"
                                      Maximum="50000000"
                                      Value="2000000"
                                      SmallChange="100000"
                                      LargeChange="500000"
                                      SpinButtonPlacementMode="Inline" />
                    </StackPanel>
                    <TextBlock Text="Sweep staged:"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <CheckBox x:Name="SweepStagedCheckBox"
                                  Content="ON"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="16,0,8,0" />

                        <TextBlock Text="Coarse offset step:"
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0" />
                        <ui:NumberBox x:Name="SweepCoarseOffsetStepNumberBox"
                                      Width="120"
                                      Minimum="1"
                                      Maximum="64"
                                      Value="4"
                                      SpinButtonPlacementMode="Inline" />

                        <TextBlock Text="Coarse step×"
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0" />
                        <ui:NumberBox x:Name="SweepCoarseStepMultiplierNumberBox"
                                      Width="120"
                                      Minimum="1"
                                      Maximum="100"
                                      Value="5"
                                      SpinButtonPlacementMode="Inline" />

                        <TextBlock Text="TopK:"
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0" />
                        <ui:NumberBox x:Name="SweepRefineTopKNumberBox"
                                      Width="120"
                                      Minimum="1"
                                      Maximum="100"
                                      Value="8"
                                      SpinButtonPlacementMode="Inline" />

                        <TextBlock Text="Refine offset ±"
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0" />
                        <ui:NumberBox x:Name="SweepRefineOffsetRadiusNumberBox"
                                      Width="120"
                                      Minimum="0"
                                      Maximum="1024"
                                      Value="16"
                                      SpinButtonPlacementMode="Inline" />

                        <TextBlock Text="Refine steps ±"
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0" />
                        <ui:NumberBox x:Name="SweepRefineStepsRadiusNumberBox"
                                      Width="120"
                                      Minimum="0"
                                      Maximum="200"
                                      Value="3"
                                      SpinButtonPlacementMode="Inline" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,8">

                        <CheckBox x:Name="SweepOffsetCheckBox"
                                  Content="Offset"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="16,0,8,0" />
                        <TextBlock Text="x:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ui:NumberBox x:Name="SweepOffsetXMinNumberBox"
                                      Width="120"
                                      Minimum="-4096"
                                      Maximum="4096"
                                      Value="0"
                                      SpinButtonPlacementMode="Inline" />
